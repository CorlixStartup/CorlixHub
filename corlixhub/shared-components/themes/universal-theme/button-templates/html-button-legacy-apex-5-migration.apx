buttonTemplate html-button-legacy-apex-5-migration (
    name: HTML button (legacy - APEX 5 migration)
    templateClass: custom8
    button {
        normal: " <input type=\"button\" value=\"#LABEL#\" onclick=\"#JAVASCRIPT#\" id=\"#DOM_ID#\" class=\"#BUTTON_CSS_CLASSES#\" #BUTTON_ATTRIBUTES#/>"
        hot: " <input type=\"button\" value=\"#LABEL#\" onclick=\"#JAVASCRIPT#\" id=\"#DOM_ID#\" class=\"#BUTTON_CSS_CLASSES#\" #BUTTON_ATTRIBUTES#/>"
    }
)

