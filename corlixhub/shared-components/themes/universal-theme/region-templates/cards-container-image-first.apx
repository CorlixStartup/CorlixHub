regionTemplate cards-container-image-first (
    name: Cards Container - Image First
    templateClass: custom1
    templateOptions {
        preset: t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
        default: u-colors
    }
    region {
        template:
            ```html
            <div class="t-CardsRegion #REGION_CSS_CLASSES#" id="#DOM_ID#" #REGION_LANDMARK_ATTRIBUTES# #REGION_ATTRIBUTES#>
              <h2 class="t-CardsRegion-title" id="#DOM_ID#_heading" data-apex-heading>#TITLE#</h2>
                <div class="t-Region-orderBy">#ORDER_BY_ITEM#</div>
                #BODY#
                #SUB_REGIONS#
            </div>
            ```
    }
    accessibility {
        landmarkType: region
    }

    templateOption apply-theme-colors (
        name: Apply Theme Colors
        sequence: 1
        appearance {
            cssClasses: u-colors
        }
        help {
            helpText: Applies the colors from the theme's color palette to the icons or initials within cards.
        }
    )

    templateOption hiddenheadernoat (
        name: Hidden
        group: @/region/header-visibility
        sequence: 1
        appearance {
            cssClasses: [
                t-CardsRegion--removeHeader
                js-removeLandmark
            ]
        }
    )

    templateOption hideregionheader (
        name: Hidden but accessible
        group: @/region/header-visibility
        sequence: 1
        appearance {
            cssClasses: [
                t-CardsRegion--hideHeader
                js-addHiddenHeadingRoleDesc
            ]
        }
        help {
            helpText: This option will hide the region header. Note that the region title will still be audible for Screen Readers.
        }
    )

    templateOption style-a (
        name: Style A
        group: @/region/style-3
        sequence: 10
        appearance {
            cssClasses: t-CardsRegion--styleA
        }
    )

    templateOption style-b (
        name: Style B
        group: @/region/style-3
        sequence: 20
        appearance {
            cssClasses: t-CardsRegion--styleB
        }
    )

    templateOption style-c (
        name: Style C
        group: @/region/style-3
        sequence: 30
        appearance {
            cssClasses: t-CardsRegion--styleC
        }
    )

    slot regionBody (
        name: Region Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
    )

    slot sortOrder (
        name: Sort Order
        staticId: ORDER_BY_ITEM
        supports {
            regions: false
            items: true
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot subRegions (
        name: Sub Regions
        staticId: SUB_REGIONS
    )

)

