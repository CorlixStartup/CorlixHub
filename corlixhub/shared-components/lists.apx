list emitir-comunicado (
    name: Emitir Comunicado

    entry step-1 (
        label: Step 1
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 17
            }
        }
    )

    entry step-2 (
        label: Step 2
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 18
            }
        }
    )

    entry step-3 (
        label: Step 3
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 19
            }
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry anexo-da-formação (
        label: Anexo da formação
        icon {
            imageIconCssClasses: fa-file-o
        }
        layout {
            sequence: 220
        }
        isCurrent {
            type: pages
            pages: 21
        }
        link {
            target: {
                page: 21
            }
        }
    )

    entry cadastros (
        label: Cadastro de Usuários
        icon {
            imageIconCssClasses: fa-user-plus
        }
        layout {
            sequence: 70
        }
        isCurrent {
            type: pages
            pages: 14
        }
        link {
            target: {
                page: 14
            }
        }
        security {
            authorizationScheme: @somente-diretoria
        }
    )

    entry central-de-equipes (
        label: Central de Equipes
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 160
        }
        isCurrent {
            type: pages
            pages: [
                26
                27
            ]
        }
        link {
            target: {
                page: 26
            }
        }
    )

    entry chat (
        label: Chat
        icon {
            imageIconCssClasses: fa-comments-o
        }
        layout {
            sequence: 170
        }
        isCurrent {
            type: pages
            pages: 4
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry colaboradores (
        label: Colaboradores
        icon {
            imageIconCssClasses: fa-users-alt
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: 12
        }
        link {
            target: {
                page: 12
            }
        }
    )

    entry comunicação (
        label: Comunicados
        icon {
            imageIconCssClasses: fa-commenting-o
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 11
        }
        link {
            target: {
                page: 11
            }
        }
    )

    entry dashboard-rh (
        label: Dashboard RH
        icon {
            imageIconCssClasses: fa-file-o
        }
        layout {
            sequence: 210
        }
        isCurrent {
            type: pages
            pages: 20
        }
        link {
            target: {
                page: 20
            }
        }
    )

    entry emitir-comunicado (
        label: Emitir Comunicado
        icon {
            imageIconCssClasses: fa-magic
        }
        layout {
            sequence: 80
            parentEntry: @home
        }
        isCurrent {
            type: pages
            pages: 17
        }
        link {
            target: {
                page: 17
            }
        }
        security {
            authorizationScheme: @publicador-de-conteudo
        }
    )

    entry empresas-cadastradas (
        label: Empresas Cadastradas
        icon {
            imageIconCssClasses: fa-building-o
        }
        layout {
            sequence: 110
        }
        isCurrent {
            type: pages
            pages: [
                15
                16
            ]
        }
        link {
            target: {
                page: 15
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry formações-e-certificações (
        label: Formações e certificações
        icon {
            imageIconCssClasses: fa-file-o
        }
        layout {
            sequence: 200
        }
        isCurrent {
            type: pages
            pages: 19
        }
        link {
            target: {
                page: 19
            }
        }
    )

    entry histórico-de-carreira (
        label: Histórico de carreira
        icon {
            imageIconCssClasses: fa-workflow
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: 13
        }
        link {
            target: {
                page: 13
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry meu-perfil (
        label: Meu Perfil
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 2
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry organograma (
        label: Organograma
        icon {
            imageIconCssClasses: fa-tree-org
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 3
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry sair (
        label: Sair
        icon {
            imageIconCssClasses: fa-box-arrow-out-east
        }
        layout {
            sequence: 10000
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

    entry solicitar-correção (
        label: Solicitar correção
        icon {
            imageIconCssClasses: fa-file-o
        }
        layout {
            sequence: 230
        }
        isCurrent {
            type: pages
            pages: 22
        }
        link {
            target: {
                page: 22
            }
        }
    )

    entry terminal (
        label: Monitor de Logs
        icon {
            imageIconCssClasses: fa-terminal
        }
        layout {
            sequence: 190
        }
        isCurrent {
            type: pages
            pages: 7
        }
        link {
            target: {
                page: 7
            }
        }
    )

)

