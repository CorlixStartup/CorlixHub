authorization admin-rh (
    name: ADMIN_RH
    type: isInRoleOrGroup
    settings {
        names: Admin RH
    }
    error {
        errorMessage: Acesso restrito ao RH.
    }
    advanced {
        evaluationType: perSession
    }
)

authorization administration-rights (
    name: EQUIPE_CORLIX_HUB
    type: isInRoleOrGroup
    settings {
        names: Equipe do Corlix Hub
    }
    error {
        errorMessage: Acesso restrito à equipe do Corlix Hub.
    }
    advanced {
        evaluationType: perSession
    }
)

authorization colaborador (
    name: COLABORADOR
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            declare
              l_qt pls_integer;
            begin
              if apex_authorization.is_authorized('ADMIN_RH') then
                return true;
              end if;
              select count(*)
                into l_qt
                from colaborador
               where upper(login_apex) = upper(:APP_USER)
                 and id_empresa = :G_ID_EMPRESA;
              return l_qt > 0;
            end;
            ```
    }
    advanced {
        evaluationType: perSession
    }
)

authorization gestor (
    name: GESTOR
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            declare
              l_qt pls_integer;
            begin
              select count(*)
                into l_qt
                from colaborador s
                join colaborador g on g.id_colaborador = s.id_gestor
               where upper(g.login_apex) = upper(:APP_USER)
                 and g.id_empresa = :G_ID_EMPRESA;
              return l_qt > 0;
            end;
            ```
    }
    advanced {
        evaluationType: perSession
    }
)

