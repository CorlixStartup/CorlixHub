lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov colaborador-nome-completo (
    name: COLABORADOR.NOME_COMPLETO
    source {
        tableName: COLABORADOR
    }
    columnMapping {
        return: ID_COLABORADOR
        display: NOME_COMPLETO
        defaultSort: NOME_COMPLETO
    }
)

lov departamento-nome (
    name: DEPARTAMENTO.NOME
    source {
        tableName: DEPARTAMENTO
    }
    columnMapping {
        return: ID_DEPARTAMENTO
        display: NOME
        defaultSort: NOME
    }
)

lov empresa-nome (
    name: EMPRESA.NOME
    source {
        tableName: EMPRESA
    }
    columnMapping {
        return: ID_EMPRESA
        display: NOME
        defaultSort: NOME
    }
)

lov lov-colaborador-ativo (
    name: LOV_COLABORADOR_ATIVO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select nome_completo d, id_colaborador r
              from colaborador
             where id_empresa = :G_ID_EMPRESA
               and status = true
             order by nome_completo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-departamento-empresa (
    name: LOV_DEPARTAMENTO_EMPRESA
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select nome d, id_departamento r
              from departamento
             where id_empresa = :G_ID_EMPRESA
             order by nome
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov lov-tipo-formacao (
    name: LOV_TIPO_FORMACAO
    source {
        location: staticValues
    }

    entry certificacao (
        sequence: 5
        display: Certificação
        return: CERTIFICACAO
    )

    entry curso (
        sequence: 4
        display: Curso
        return: CURSO
    )

    entry graduacao (
        sequence: 1
        display: Graduação
        return: GRADUACAO
    )

    entry idioma (
        sequence: 6
        display: Idioma
        return: IDIOMA
    )

    entry mba (
        sequence: 3
        display: MBA
        return: MBA
    )

    entry pos (
        sequence: 2
        display: Pós-graduação
        return: POS
    )

)

lov lov-tipo-movimentacao (
    name: LOV_TIPO_MOVIMENTACAO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ds_tipo d, id_tipo_movimentacao r
              from tipo_movimentacao
             where id_empresa = :G_ID_EMPRESA
               and fl_ativo = true
             order by nr_ordem, ds_tipo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

