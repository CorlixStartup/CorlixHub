page 15 (
    name: Empresas Cadastradas
    alias: EMPRESAS-CADASTRADAS
    title: Empresas Cadastradas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region empresas-cadastradas (
        name: Empresas Cadastradas
        type: interactiveReport
        source {
            location: localDatabase
            tableName: EMPRESA
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 16
                items: {
                    P16_ID_EMPRESA: \#ID_EMPRESA#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 9983244636177663
        }

        column BAIRRO (
            type: plainText
            heading {
                heading: Bairro
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CEP (
            type: plainText
            heading {
                heading: CEP
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CIDADE (
            type: plainText
            heading {
                heading: Cidade
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column CNPJ (
            type: plainText
            heading {
                heading: CNPJ
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMPLEMENTO (
            type: plainText
            heading {
                heading: Complemento
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DATA_CRIACAO (
            type: plainText
            heading {
                heading: Data de Criação
            }
            layout {
                sequence: 4
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMAIL_CORPORATIVO (
            type: plainText
            heading {
                heading: Email Corporativo
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID_EMPRESA (
            type: hidden
            heading {
                heading: Id Empresa
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column LOGRADOURO (
            type: plainText
            heading {
                heading: Logradouro
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column NOME (
            type: plainText
            heading {
                heading: Razão Social
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NOME_FANTASIA (
            type: plainText
            heading {
                heading: Nome Fantasia
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Número
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column STATUS (
            type: plainTextBasedOnLov
            heading {
                heading: Status
            }
            lov {
                lov: @boolean
            }
            layout {
                sequence: 15
            }
            source {
                dataType: BOOLEAN
            }
            advanced {
                endUserAlias: O
            }
        )

        column TELEFONE (
            type: plainText
            heading {
                heading: Telefone
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column UF (
            type: plainText
            heading {
                heading: UF
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BAIRRO (
                sequence: 12
            )

            displayColumn CEP (
                sequence: 8
            )

            displayColumn CIDADE (
                sequence: 13
            )

            displayColumn CNPJ (
                sequence: 3
            )

            displayColumn COMPLEMENTO (
                sequence: 11
            )

            displayColumn DATA_CRIACAO (
                sequence: 4
            )

            displayColumn EMAIL_CORPORATIVO (
                sequence: 6
            )

            displayColumn ID_EMPRESA (
                sequence: 1
            )

            displayColumn LOGRADOURO (
                sequence: 9
            )

            displayColumn NOME (
                sequence: 2
            )

            displayColumn NOME_FANTASIA (
                sequence: 5
            )

            displayColumn NUMERO (
                sequence: 10
            )

            displayColumn STATUS (
                sequence: 15
            )

            displayColumn TELEFONE (
                sequence: 7
            )

            displayColumn UF (
                sequence: 14
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Cadastrar
        layout {
            sequence: 10
            region: @empresas-cadastradas
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 16
                clearCache: 16
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @empresas-cadastradas
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @empresas-cadastradas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

