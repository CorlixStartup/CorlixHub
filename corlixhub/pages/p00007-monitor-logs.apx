    region apex_workspace_activity_log (
        name: Erros de página (APEX)
        title: Erros de página (APEX)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select from_tz(cast(view_date as timestamp), 'UTC') at time zone 'America/Sao_Paulo' as data_hora,
                       application_id  as app,
                       page_id         as pagina,
                       page_name       as nome_pagina,
                       apex_user       as usuario,
                       error_message   as erro,
                       error_on_component_type as tipo_componente,
                       error_on_component_name as componente
                  from apex_workspace_activity_log
                 where error_message is not null
                ```
        }
        layout {
            sequence: 20
            parentRegion: @logs
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div class="log-descricao">
                  <span class="fa fa-info-circle" aria-hidden="true"></span>
                  <div>
                    Erros registrados pelo próprio APEX ao carregar ou enviar páginas.
                    <div>
                      <span class="log-tag">Registro nativo</span>
                      <span class="log-tag">Retenção definida pelo APEX</span>
                    </div>
                  </div>
                </div>
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 21016543990847906
        }

