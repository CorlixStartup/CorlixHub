page 7 (
    name: Monitor de Logs
    alias: MONITOR_LOGS
    title: Monitor de Logs
    appearance {
        pageTemplate: @corlix-standard-page
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region apex_debug_messages (
        name: Debug detalhado (APEX)
        title: Debug detalhado (APEX)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.id,
                       cast(m.message_timestamp as timestamp with time zone) at time zone 'America/Sao_Paulo' as data_hora,
                       m.application_id as app,
                       m.page_id        as pagina,
                       m.apex_user      as usuario,
                       m.session_id     as sessao,
                       case
                         when m.message_level = 1 then 'ERRO'
                         when m.message_level = 2 then 'AVISO'
                         when m.message_level = 4 then 'INFO'
                         else 'DEBUG'
                       end as nivel,
                       case
                         when m.message_level = 1 then 'u-danger'
                         when m.message_level = 2 then 'u-warning'
                         when m.message_level = 4 then 'u-info'
                         else 'u-normal'
                       end as nivel_css,
                       m.message        as mensagem,
                       m.message_level
                  from apex_debug_messages m
                ```
        }
        layout {
            sequence: 30
            parentRegion: @logs
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div class="log-descricao">
                  <span class="fa fa-info-circle" aria-hidden="true"></span>
                  <div>
                    Rastreamento completo das páginas executadas com <strong>Debug</strong> ligado. Use para investigar um problema específico.
                    <div>
                      <span class="log-tag">Requer Debug ativo</span>
                      <span class="log-tag">Uso técnico</span>
                    </div>
                  </div>
                </div>
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Dados não encontrados.
            whenMoreDataFound: A contagem máxima de linhas deste relatório é #MAX_ROW_COUNT# linhas. Aplique um filtro para reduzir o número de registros em sua consulta.
        }
        advanced {
            savedReportMappingIdentifier: 25219825823518531
        }

        column APP (
            type: plainText
            heading {
                heading: App
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column DATA_HORA (
            type: plainText
            heading {
                heading: Data Hora
            }
            layout {
                sequence: 2
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI:SS
            }
