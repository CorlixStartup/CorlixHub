    region app_log (
        name: Log da aplicação
        title: Log da aplicação
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id,
                       log_ts at time zone 'America/Sao_Paulo' as data_hora,
                       nivel,
                       case nivel
                         when 'ERRO'  then 'u-danger'
                         when 'AVISO' then 'u-warning'
                         when 'INFO'  then 'u-info'
                         else 'u-normal'
                       end as nivel_css,
                       app_id, page_id, apex_user, session_id, origem, mensagem, detalhe
                  from app_log
                ```
        }
        layout {
            sequence: 10
            parentRegion: @logs
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div class="log-descricao">
                  <span class="fa fa-info-circle" aria-hidden="true"></span>
                  <div>
                    Erros capturados automaticamente e mensagens gravadas pelo código com <code>log_pkg</code>.
                    <div>
                      <span class="log-tag">Automático</span>
                      <span class="log-tag">Histórico de 30 dias</span>
                    </div>
                  </div>
                </div>
                ```
        }
