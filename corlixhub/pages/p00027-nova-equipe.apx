    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P27_ID_EQUIPE
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @botões
            slot: delete
        }
        appearance {
