        }
    )

    process fechar-caixa-de-diálogo (
        name: Fechar Caixa de Diálogo
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 22104832932336895
        }
        serverSideCondition {
            type: requestIsContainedInValue
