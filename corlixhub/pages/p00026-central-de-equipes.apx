page 26 (
    name: Central de Equipes
    alias: CENTRAL-DE-EQUIPES
    title: Central de Equipes
    appearance {
        pageTemplate: @corlix-standard-page
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region central-de-equipes (
        name: Central de Equipes
        type: classicReport
        source {
            location: localDatabase
            tableName: EQUIPE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Dados não encontrados.
        }

        column DATA_CRIACAO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Data Criacao
            }
            layout {
                sequence: 7
            }
        )

        column DESCRICAO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Descricao
            }
            layout {
                sequence: 6
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ID_CRIADOR (
            reportColumnQueryId: 4
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Id Criador
            }
            lov {
                type: sharedComponent
                lov: @colaborador-nome-completo
            }
            layout {
                sequence: 4
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ID_DEPARTAMENTO (
            reportColumnQueryId: 3
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Id Departamento
            }
            lov {
                type: sharedComponent
                lov: @departamento-nome
            }
            layout {
                sequence: 3
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ID_EMPRESA (
            reportColumnQueryId: 2
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Id Empresa
            }
            lov {
                type: sharedComponent
                lov: @empresa-nome
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column ID_EQUIPE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 0
                columnAlignment: center
            }
            link {
                target: {
                    page: 27
                    items: {
                        P27_ID_EQUIPE: \#ID_EQUIPE#\
                    }
                    action: resetPagination
                }
                linkText: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
            }
            sorting {
                sortable: false
            }
        )

        column NOME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Nome
            }
            layout {
                sequence: 5
            }
            sorting {
                defaultSequence: 1
            }
        )

        column STATUS (
            reportColumnQueryId: 8
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Status
            }
            lov {
                type: sharedComponent
                lov: @boolean
            }
            layout {
                sequence: 8
            }
        )

    )

    region navegação-estrutural (
        name: Navegação Estrutural
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 10
            region: @central-de-equipes
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 27
                clearCache: 27
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction editar-relatório-caixa-de-diálogo-fechada (
        name: Editar Relatório - Caixa de Diálogo Fechada
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @central-de-equipes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @central-de-equipes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

