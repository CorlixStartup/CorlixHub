        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P18_ST_REGISTRO, 'RASCUNHO') = 'RASCUNHO'
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    dynamicAction cancelar (
        name: Cancelar
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar (
            name: Cancelar
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction tipo-mudou (
        name: Tipo mudou
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P18_ID_TIPO_MOVIMENTACAO
        }

        action ação-1 (
            name: Buscar código do tipo
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select cd_tipo
                      from tipo_movimentacao
                     where id_tipo_movimentacao = :P18_ID_TIPO_MOVIMENTACAO
                       and id_empresa = :G_ID_EMPRESA
                    ```
                itemsToSubmit: P18_ID_TIPO_MOVIMENTACAO
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P18_CD_TIPO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action ação-2 (
            name: Ajustar campos
            action: executeJsCode
            settings {
                jsCode: carreira.ajustarCampos(true);
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process efetivar (
        name: Efetivar
        type: executeCode
        source {
            plsqlCode: pkg_historico_carreira.efetivar_movimentacao(:P18_ID_HISTORICO_CARREIRA);
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Movimentação efetivada.
        }
        advanced {
            executionMappingIdentifier: 32808210824326814
        }
        serverSideCondition {
            whenButtonPressed: @efetivar
        }
    )

    process estornar (
        name: Estornar
        type: executeCode
        source {
            plsqlCode: pkg_historico_carreira.estornar_movimentacao(:P18_ID_HISTORICO_CARREIRA, :P18_DS_MOTIVO_ESTORNO);
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Lançamento estornado.
        }
        advanced {
            executionMappingIdentifier: 32808352054326815
        }
        serverSideCondition {
            whenButtonPressed: @estornar
        }
    )

    process excluir-rascunho (
        name: Excluir rascunho
        type: executeCode
        source {
            plsqlCode: pkg_historico_carreira.excluir_rascunho(:P18_ID_HISTORICO_CARREIRA);
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Excluir rascunho
        }
        advanced {
            executionMappingIdentifier: 32808402069326816
        }
        serverSideCondition {
            whenButtonPressed: @excluir
        }
    )

    process fechar (
        name: Fechar
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 32808568747326817
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SALVAR_RASCUNHO,EFETIVAR,ESTORNAR,EXCLUIR
        }
    )

    process initialize-form-movimentação (
        name: Initialize form Movimentação
        type: formInitialization
        formRegion: @movimentação
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 31448997914538707
        }
    )

    process salvar-movimentação (
        name: Salvar movimentação
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P18_ID_HISTORICO_CARREIRA is null then
                    :P18_ID_HISTORICO_CARREIRA := pkg_historico_carreira.registrar_movimentacao(
                      p_id_colaborador       => :P18_ID_COLABORADOR,
                      p_id_tipo_movimentacao => :P18_ID_TIPO_MOVIMENTACAO,
                      p_dt_efetiva           => to_date(:P18_DT_EFETIVA, 'DD/MM/YYYY'),
                      p_id_cargo_novo        => :P18_ID_CARGO_NOVO,
                      p_id_departamento_novo => :P18_ID_DEPARTAMENTO_NOVO,
                      p_id_gestor_novo       => :P18_ID_GESTOR_NOVO,
                      p_vl_salario_anterior  => to_number(:P18_VL_SALARIO_ANTERIOR),
                      p_vl_salario_novo      => to_number(:P18_VL_SALARIO_NOVO),
                      p_ds_motivo            => :P18_DS_MOTIVO,
                      p_ds_observacao        => :P18_DS_OBSERVACAO,
                      p_id_aprovador         => :P18_ID_APROVADOR);
                  else
                    pkg_historico_carreira.atualizar_rascunho(
                      p_id_historico_carreira => :P18_ID_HISTORICO_CARREIRA,
                      p_id_tipo_movimentacao  => :P18_ID_TIPO_MOVIMENTACAO,
                      p_dt_efetiva            => to_date(:P18_DT_EFETIVA, 'DD/MM/YYYY'),
                      p_id_cargo_novo         => :P18_ID_CARGO_NOVO,
                      p_id_departamento_novo  => :P18_ID_DEPARTAMENTO_NOVO,
                      p_id_gestor_novo        => :P18_ID_GESTOR_NOVO,
                      p_vl_salario_anterior   => to_number(:P18_VL_SALARIO_ANTERIOR),
                      p_vl_salario_novo       => to_number(:P18_VL_SALARIO_NOVO),
