    pageItem P18_ID_CARGO_NOVO (
        type: popupLov
        label {
            label: Novo cargo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select cg.nome     as d,
                                       cg.id_cargo as r
                                  from cargo cg
                                 where cg.id_empresa = :G_ID_EMPRESA
                                   and cg.id_departamento = coalesce(to_number(:P18_ID_DEPARTAMENTO_NOVO),
                                                                     to_number(:P18_ID_DEPARTAMENTO_ATUAL))
                                 order by cg.nome
                ```
        }
        cascadingLov {
            parentItems: P18_ID_DEPARTAMENTO_NOVO
            itemsToSubmit: P18_ID_DEPARTAMENTO_ATUAL
            parentRequired: false
        }
        layout {
            sequence: 70
            region: @movimentação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @movimentação
            column: ID_CARGO_NOVO
            dataType: number
        }
    )

