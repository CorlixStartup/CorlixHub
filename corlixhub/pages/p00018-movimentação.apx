                ```sql
                select cg.nome     as d,
                                       cg.id_cargo as r
                                  from cargo cg
                                 where cg.id_empresa = :G_ID_EMPRESA
                                   and cg.id_departamento = coalesce(to_number(:P18_ID_DEPARTAMENTO_NOVO),
                                                                     to_number(:P18_ID_DEPARTAMENTO_ATUAL))
                                 order by cg.nome
                ```
        }
        cascadingLov {
            parentItems: P18_ID_DEPARTAMENTO_NOVO
            itemsToSubmit: P18_ID_DEPARTAMENTO_ATUAL
            parentRequired: false
