    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botões
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    button efetivar (
        buttonName: EFETIVAR
        label: Efetivar
        layout {
            sequence: 50
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Depois de efetivado, o lançamento não pode ser alterado. Continuar?
            style: warning
        }
        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P18_ST_REGISTRO, 'RASCUNHO') = 'RASCUNHO'
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    button estornar (
        buttonName: ESTORNAR
        label: Estornar
        layout {
            sequence: 30
            region: @botões
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Estornar este lançamento?
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P18_ST_REGISTRO = 'EFETIVADO' and :P18_FL_ESTORNO = 'N'
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    button excluir (
        buttonName: EXCLUIR
        label: Excluir rascunho
        layout {
            sequence: 20
            region: @botões
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Excluir este rascunho?
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P18_ST_REGISTRO = 'RASCUNHO' and :P18_ID_HISTORICO_CARREIRA is not null
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

