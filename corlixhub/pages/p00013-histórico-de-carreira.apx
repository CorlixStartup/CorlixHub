            affectedElements {
                selectionType: region
                region: @lançamentos-rh
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process colaborador-padrão (
        name: Colaborador padrão
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P13_ID_COLABORADOR is null then
                    select id_colaborador
                      into :P13_ID_COLABORADOR
                      from colaborador
                     where upper(trim(login_apex)) = upper(trim(:APP_USER))
                       and id_empresa = :G_ID_EMPRESA;
                  end if;
                exception
                  when no_data_found or too_many_rows then
                    raise_application_error(-20012,
                      'Sua conta não está vinculada a um colaborador desta empresa. Fale com o RH.');
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29919817957540304
        }
    )

    process registrar-acesso-salarial (
        name: Registrar acesso salarial
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                pkg_historico_carreira.registrar_acesso_salarial(
                  p_id_colaborador => :P13_ID_COLABORADOR,
                  p_contexto       => 'P13 · lançamentos do histórico');
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29920024740540306
        }
        security {
            authorizationScheme: @admin-rh
        }
    )

    process validar-acesso (
        name: Validar acesso
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P13_ID_COLABORADOR is null
                   or pkg_historico_carreira.fn_pode_ver_colaborador(:P13_ID_COLABORADOR) = 'N' then
                  raise_application_error(-20012, 'Você não tem acesso ao histórico deste colaborador.');
                end if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29919984358540305
        }
    )

