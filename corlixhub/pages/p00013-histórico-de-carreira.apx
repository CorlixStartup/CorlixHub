    region historico_carreira (
        name: Histórico de Carreiras
        type: dynamicContent
        source {
            plsqlFunctionBody: return pkg_historico_carreira_ui.render(:P13_ID_COLABORADOR);
            pageItemsToSubmit: P13_ID_COLABORADOR
