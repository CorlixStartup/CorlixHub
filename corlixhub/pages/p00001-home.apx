    region id-lista-de-comunicados (
        name: lista_de_comunicados
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                  c.ID_COMUNICADO,
                  c.TITULO,
                  DBMS_LOB.SUBSTR(c.CONTEUDO, 250, 1) CONTEUDO,
                  c.DATA_PUBLICACAO,
                  c.IMAGEM,
                  c.MIME_TYPE,
                  c.NOME_ARQUIVO,
                  NVL(d.NOME, 'Geral') DEPARTAMENTO,
                  'dept-' || NVL(TO_CHAR(MOD(d.ID_DEPARTAMENTO, 6)), 'geral') CLASSE_DEPTO,
                  CASE TRUNC(SYSDATE) - TRUNC(c.DATA_PUBLICACAO)
                    WHEN 0 THEN 'Hoje'
                    WHEN 1 THEN 'Ontem'
                    ELSE TO_CHAR(TRUNC(SYSDATE) - TRUNC(c.DATA_PUBLICACAO)) || ' dias atrás'
                  END TEMPO_PUBLICACAO
                FROM COMUNICADO c
                LEFT JOIN DEPARTAMENTO d
                  ON d.ID_DEPARTAMENTO = c.ID_DEPARTAMENTO
                ORDER BY c.DATA_PUBLICACAO DESC
                FETCH FIRST 3 ROWS ONLY;
                 
                ```
        }
        layout {
            sequence: 30
            parentRegion: @card-comunicados-oficiais
            slot: subRegions
            columnCssClasses: lista-de-comunicados
        }
        appearance {
            template: @cards-container-image-first
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        componentAppearance {
            layout: horizontal
        }
        card {
            primaryKeyColumn1: ID_COMUNICADO
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="cmt-meta">
                  <span class="cx-etiqueta">&DEPARTAMENTO.</span>
                  <span class="cmt-date">&TEMPO_PUBLICACAO.</span>
                </div>
                <div class="cmt-title">&TITULO.</div>
                ```
        }
        body {
            column: CONTEUDO
        }
        media {
            source: blobColumn
            blobColumn: IMAGEM
            position: first
            cssClasses: imagem-capa-comunicado
        }
        blobAttributes {
            mimeTypeColumn: MIME_TYPE
        }
    )

