    region lista-aniversariantes (
        name: lista_aniversariantes
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                                    ID_COLABORADOR,
                                    NOME_COMPLETO,
                                    DATA_DE_NASCIMENTO,
                                
                                    -- Retorna o caminho exato corrigido e validado para o APEX
                                    CASE
                                        WHEN FOTO_URL IS NULL
                                             OR FOTO_URL = '#APP_FILES#Fotos Colaboradores/'
                                        THEN
                                            '#APP_FILES#Fotos Colaboradores/'
                                        ELSE
                                            '#APP_FILES#Fotos Colaboradores/' || FOTO_URL
                                    END AS FOTO_URL,
                                
                                    -- Seu vínculo de NOME limpo para o HTML Expression
                                    NOME_COMPLETO AS NOME,
                                
                                    -- Seu vínculo de DESCRICAO limpa para o HTML Expression
                                    CASE
                                        WHEN TO_CHAR(DATA_DE_NASCIMENTO, 'MMDD') = TO_CHAR(CAST(SYSTIMESTAMP AT TIME ZONE 'America/Sao_Paulo' AS DATE), 'MMDD') THEN 'Hoje'
                                        WHEN TO_CHAR(DATA_DE_NASCIMENTO, 'MMDD') = TO_CHAR(CAST(SYSTIMESTAMP AT TIME ZONE 'America/Sao_Paulo' AS DATE) + 1, 'MMDD') THEN 'Amanhã, ' || TO_CHAR(DATA_DE_NASCIMENTO, 'DD') || ' de ' || RTRIM(TO_CHAR(DATA_DE_NASCIMENTO, 'Month', 'NLS_DATE_LANGUAGE=PORTUGUESE'))
                                        ELSE TO_CHAR(DATA_DE_NASCIMENTO, 'DD') || ' de ' || RTRIM(TO_CHAR(DATA_DE_NASCIMENTO, 'Month', 'NLS_DATE_LANGUAGE=PORTUGUESE'))
                                    END AS DESCRICAO,
                                
                                    -- Seu vínculo de classe CSS condicional
                                    CASE 
                                        WHEN TO_CHAR(DATA_DE_NASCIMENTO, 'MMDD') = TO_CHAR(CAST(SYSTIMESTAMP AT TIME ZONE 'America/Sao_Paulo' AS DATE), 'MMDD') THEN 'is-birthday-today'
                                        ELSE 'is-normal-day'
                                    END AS CSS_NIVER_HOJE,
                                
                                    -- Seu código original do mês corrente
                                    RTRIM(
                                        INITCAP(
                                            TO_CHAR(
                                                CAST(SYSTIMESTAMP AT TIME ZONE 'America/Sao_Paulo' AS DATE),
                                                'Month',
                                                'NLS_DATE_LANGUAGE=PORTUGUESE'
                                            )
                                        )
                                    ) AS MES_CORRENTE
                                
                                FROM COLABORADOR
                                WHERE TO_CHAR(DATA_DE_NASCIMENTO, 'MM') = TO_CHAR(CAST(SYSTIMESTAMP AT TIME ZONE 'America/Sao_Paulo' AS DATE), 'MM')
                                ORDER BY EXTRACT(DAY FROM DATA_DE_NASCIMENTO)
                                
                                -- [NOVA TRAVA]: Garante que a Home exiba apenas até 5 pessoas, independente de quantas existam no banco
                                FETCH FIRST 5 ROWS ONLY;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @card-aniversariantes
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="figma-row &CSS_NIVER_HOJE.">
                    <!-- Foto Circular com Fallback Corrigido para Usuário Padrão -->
                    <div class="figma-avatar-wrapper">
                        <img src="&FOTO_URL." alt="Foto de perfil" class="figma-avatar-img" onerror="this.onerror=null; this.src='#APP_FILES#default-user.jpeg';">
                    </div>
                    
                    <!-- Bloco de Texto Empilhado -->
                    <div class="figma-info-wrapper">
                        <span class="figma-name-text">&NOME.</span>
                        <span class="figma-date-text">
                            &DESCRICAO.
                            <!-- O bolo só aparece se for HOJE através do CSS condicional -->
                            <span class="figma-cake-icon">🎂</span>
                        </span>
                    </div>
                </div>
                ```
        }
    )

