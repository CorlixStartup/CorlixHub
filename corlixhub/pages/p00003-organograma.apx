page 3 (
    name: Organograma
    alias: ORGANOGRAMA
    title: Organograma
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            const ORG_ITEM_FOCO         = "P3_ID_FOCO";
            const ORG_REGIAO            = "organograma";
            const ORG_PROCESSO_DETALHES = "ORG_DETALHES";
            
            let orgDrawer = null;
            let orgPedido = 0;
            
            function orgId(valor) {
              const id = Number(valor);
              return Number.isFinite(id) && id > 0 ? id : null;
            }
            
            function orgIrPara(valor) {
              const id = orgId(valor);
              if (!id) return;
              apex.item(ORG_ITEM_FOCO).setValue(String(id));
              apex.region(ORG_REGIAO).refresh();
            }
            
            function orgObterDrawer() {
              if (orgDrawer) return orgDrawer;
            
              orgDrawer = document.createElement("dialog");
              orgDrawer.className = "org-drawer";
              orgDrawer.setAttribute("aria-labelledby", "org-drawer-nome");
              orgDrawer.innerHTML = '<div class="org-drawer__painel"></div>';
              orgDrawer.addEventListener("click", orgCliqueNoDrawer);
              document.body.appendChild(orgDrawer);
            
              return orgDrawer;
            }
            
            function orgEstado(html) {
              return '<div class="org-drawer__estado">' + html + "</div>";
            }
            
            function orgAbrirDetalhes(valor) {
              const id = orgId(valor);
              if (!id) return;
            
              const drawer = orgObterDrawer();
              const painel = drawer.firstElementChild;
              const pedido = ++orgPedido;
            
              painel.setAttribute("aria-busy", "true");
            
              painel.innerHTML = orgEstado(
                '<span class="org-spinner" aria-hidden="true"></span><p>Carregando detalhes...</p>'
              );
            
              if (!drawer.open) drawer.showModal();
            
              apex.server.process(
                ORG_PROCESSO_DETALHES,
                { x01: id },
                { dataType: "text" }
              )
              .done(function (html) {
                if (pedido !== orgPedido) return;
            
                painel.innerHTML = html;
            
                const titulo =
                  painel.querySelector("#org-drawer-nome");
            
                if (titulo) titulo.focus();
              })
              .fail(function () {
                if (pedido !== orgPedido) return;
            
                painel.innerHTML =
                  orgEstado(
                    "<p>Não foi possível carregar os detalhes.</p>" +
                    '<button type="button" class="org-btn org-btn--auto" data-acao="detalhe" data-id="' + id + '">' +
                    "Tentar novamente</button>" +
                    '<button type="button" class="org-link" data-acao="fechar">Fechar</button>'
                  );
              })
              .always(function () {
                if (pedido === orgPedido) {
                  painel.removeAttribute("aria-busy");
                }
              });
            }
            
            function orgCopiar(botao) {
              if (!navigator.clipboard) return;
            
              const aviso =
                botao.parentElement.querySelector(".org-sr");
            
              navigator.clipboard.writeText(
                botao.dataset.valor
              ).then(function () {
            
                botao.classList.add("is-copiado");
                botao.setAttribute(
                  "aria-label",
                  "E-mail copiado"
                );
            
                if (aviso) {
                  aviso.textContent =
                    "E-mail copiado.";
                }
            
                setTimeout(function () {
            
                  botao.classList.remove(
                    "is-copiado"
                  );
            
                  botao.setAttribute(
                    "aria-label",
                    "Copiar e-mail"
                  );
            
                  if (aviso) {
                    aviso.textContent = "";
                  }
            
                }, 2000);
            
              });
            }
            
            function orgCliqueNoDrawer(ev) {
              const drawer = ev.currentTarget;
            
              if (ev.target === drawer) {
                drawer.close();
                return;
              }
            
              const alvo =
                ev.target.closest("[data-acao]");
            
              if (!alvo) return;
            
              switch (alvo.dataset.acao) {
            
                case "fechar":
                  drawer.close();
                  break;
            
                case "detalhe":
                  orgAbrirDetalhes(
                    alvo.dataset.id
                  );
                  break;
            
                case "equipe":
                  drawer.close();
                  orgIrPara(
                    alvo.dataset.id
                  );
                  break;
            
                case "copiar":
                  orgCopiar(alvo);
                  break;
              }
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            $("#" + ORG_REGIAO)
              .on(
                "click",
                "[data-acao]",
                function () {
            
                  if (
                    this.dataset.acao === "foco"
                  ) {
            
                    orgIrPara(
                      this.dataset.id
                    );
            
                  } else if (
                    this.dataset.acao ===
                    "detalhe"
                  ) {
            
                    orgAbrirDetalhes(
                      this.dataset.id
                    );
            
                  }
            
                }
              );
            
            $("#" + ORG_REGIAO)
              .on(
                "apexafterrefresh",
                function () {
            
                  const titulo =
                    document.getElementById(
                      "org-foco-nome"
                    );
            
                  if (titulo) {
                    titulo.focus({
                      preventScroll: true
                    });
                  }
            
                }
              );
            ```
    }
    css {
        fileUrls: #APP_FILES#organograma.css.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region organograma (
        name: Organograma Principal
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                return pkg_organograma.render(
                         to_number(:P3_ID_FOCO default null on conversion error));
                ```
            pageItemsToSubmit: P3_ID_FOCO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_BUSCA (
        type: popupLov
        label {
            label: Novo
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select nome_completo || ' — ' || cargo d,
                       id_colaborador r
                from vw_org_colaborador
                order by nome_completo
                ```
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Buscar pessoa no organograma
        }
    )

    pageItem P3_ID_FOCO (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    dynamicAction buscar-organograma (
        name: Buscar Organograma
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P3_BUSCA
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const id = $v("P3_BUSCA");
                    
                    if (id) {
                    
                      orgIrPara(id);
                    
                      apex.item("P3_BUSCA")
                          .setValue(
                             "",
                             null,
                             true
                          );
                    
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process ORG_DETALHES (
        name: ORG_DETALHES
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_util.prn(
                  p_clob   => pkg_organograma.render_detalhes(
                                to_number(apex_application.g_x01 default null on conversion error)),
                  p_escape => false);
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 31838483813958909
        }
        config {
            buildOption: !@commented-out
        }
    )

)

