        }
        source {
            formRegion: @formação
            column: ID_EMPRESA
            dataType: number
        }
    )

    pageItem P21_ID_FORMACAO (
        type: hidden
        layout {
            sequence: 10
            region: @formação
            slot: regionBody
        }
        source {
            formRegion: @formação
            column: ID_FORMACAO
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P21_NR_CARGA_HORARIA (
        type: numberField
        label {
            label: Nr Carga Horaria
            alignment: right
        }
        layout {
