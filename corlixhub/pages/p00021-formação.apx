    pageItem P21_ID_COLABORADOR (
        type: selectList
        label {
            label: Id Colaborador
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @colaborador-nome-completo
        }
        layout {
            sequence: 30
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formação
            column: ID_COLABORADOR
            dataType: number
        }
    )

