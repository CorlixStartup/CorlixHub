    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P21_ID_FORMACAO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ID_FORMACAO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P21_ID_FORMACAO
        }
    )

    validation p21-dt-alteracao-must-be-timestamp (
        name: P21_DT_ALTERACAO must be timestamp
        execution {
            sequence: 160
        }
        validation {
            type: itemIsAValidTimestamp
            item: P21_DT_ALTERACAO
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P21_DT_ALTERACAO
        }
    )

    validation p21-dt-criacao-must-be-timestamp (
        name: P21_DT_CRIACAO must be timestamp
        execution {
            sequence: 140
        }
        validation {
            type: itemIsAValidTimestamp
            item: P21_DT_CRIACAO
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P21_DT_CRIACAO
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 33885343087136618
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-formação (
        name: Initialize form Formação
        type: formInitialization
        formRegion: @formação
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 33884590914136616
        }
    )

    process process-form-formação (
        name: Process form Formação
        type: formAutoRowProcessing
        formRegion: @formação
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 33884964000136617
        }
    )

)

