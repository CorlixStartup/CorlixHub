page 21 (
    name: Formação
    alias: FORMAÇÃO
    title: Formação
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formação (
        name: Formação
        type: form
        source {
            location: localDatabase
            tableName: FORMACAO_COLABORADOR
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P21_BL_ANEXO (
        type: fileUpload
        label {
            label: Bl Anexo
            alignment: right
        }
        layout {
            sequence: 110
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @formação
            column: BL_ANEXO
            dataType: blob
        }
    )

    pageItem P21_DS_INSTITUICAO (
        type: textField
        label {
            label: Ds Instituicao
            alignment: right
        }
        layout {
            sequence: 50
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @formação
            column: DS_INSTITUICAO
            dataType: varchar2
        }
    )

    pageItem P21_DS_LINK (
        type: textarea
        label {
            label: Ds Link
            alignment: right
        }
        layout {
            sequence: 140
            region: @formação
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @formação
            column: DS_LINK
            dataType: varchar2
        }
    )

