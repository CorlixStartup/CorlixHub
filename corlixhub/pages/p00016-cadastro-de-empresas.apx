page 16 (
    name: Cadastro de Empresas
    alias: CADASTRO-DE-EMPRESAS
    title: Cadastro de Empresas
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region cadastro-de-empresas (
        name: Cadastro de Empresas
        type: form
        source {
            location: localDatabase
            tableName: EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region configurações (
        name: Configurações
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @cadastro-de-empresas
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <h2 class="cx-titulo-secao">Configurações</h2>
        }
    )

    region contato-e-endereço (
        name: Contato e Endereço
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @cadastro-de-empresas
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: <h2 class="cx-titulo-secao">Contato e endereço</h2>
        }
    )

    region new (
