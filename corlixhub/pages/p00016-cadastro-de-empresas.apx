    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Criar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P16_ID_EMPRESA
        }
    )

    button delete (
        buttonName: DELETE
        label: Remover
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_ID_EMPRESA
        }
    )

    button save (
        buttonName: SAVE
        label: Salvar
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P16_ID_EMPRESA
        }
    )

    dynamicAction desabilitar-campos-de-endereço (
        name: Desabilitar campos de endereço
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P16_CEP
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P16_CEP
        }

        action campos-que-serão-desabilitados (
            name: Campos que serão desabilitados
            action: disable
            affectedElements {
                selectionType: items
                items: [
                    P16_LOGRADOURO
                    P16_BAIRRO
                    P16_CIDADE
                    P16_UF
                    P16_NUMERO
                    P16_COMPLEMENTO
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action campos-que-vão-estar-habilitados (
            name: Campos que vão estar habilitados
            action: enable
            affectedElements {
                selectionType: items
                items: [
                    P16_NOME_FANTASIA
                    P16_NOME
                    P16_CNPJ
                    P16_DATA_CRIACAO
                    P16_EMAIL_CORPORATIVO
                    P16_TELEFONE
                    P16_CEP
                    P16_STATUS
                    P16_LOGOTIPO_EMPRESA
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction endereço-por-cep (
        name: Endereço por CEP
        execution {
            sequence: 10
        }
        when {
            event: keyup
            selectionType: items
            items: P16_CEP
        }

        action quando-cep-for-verdade (
            name: Quando CEP for verdade
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var cep = this.triggeringElement.value.replace(/\D/g, '');
                    if (cep.length === 8) {
                      fetch(`https://viacep.com.br/ws/${cep}/json/`)
                        .then(response => response.json())
                        .then(data => {
                          if (!data.erro) {
                            apex.item("P16_LOGRADOURO").setValue(data.logradouro);
                            apex.item("P16_BAIRRO").setValue(data.bairro);
                            apex.item("P16_CIDADE").setValue(data.localidade);
                            apex.item("P16_UF").setValue(data.uf);
                    
                            // Habilita número e complemento após o preenchimento
                            apex.item("P16_NUMERO").enable();
                            apex.item("P16_COMPLEMENTO").enable();
                            apex.item("P16_NUMERO").node.focus();
                          } else {
                            apex.message.showErrors([{
                              type: "error",
                              location: "page",
                              message: "CEP não encontrado.",
                              unsafe: false
                            }]);
                    
                            // opcional: mantém desabilitado se o CEP for inválido
                            apex.item("P16_NUMERO").disable();
                            apex.item("P16_COMPLEMENTO").disable();
                          }
                        })
                        .catch(err => console.error("Erro ao consultar CEP:", err));
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9982013278177535
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-cadastro-de-empresas (
        name: Initialize form Cadastro de Empresas
        type: formInitialization
        formRegion: @cadastro-de-empresas
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9981250137177533
        }
    )

    process process-form-cadastro-de-empresas (
        name: Process form Cadastro de Empresas
        type: formAutoRowProcessing
        formRegion: @cadastro-de-empresas
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9981626380177534
        }
    )

)

