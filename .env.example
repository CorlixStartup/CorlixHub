# -----------------------------------------------------------------------------
# Corlix Hub — variáveis de ambiente para docker-compose.yml
#
# Como usar:
#   1. cp .env.example .env
#   2. Edite os valores abaixo (principalmente as senhas)
#   3. Nunca faça commit do arquivo .env (já está no .gitignore)
#
# O Docker Compose lê automaticamente um arquivo chamado ".env" na mesma pasta
# do docker-compose.yml — não é preciso passar --env-file.
# -----------------------------------------------------------------------------

# Senha do usuário SYS/SYSTEM do Oracle Database (container "db").
# Regras da imagem oficial: mínimo 8 caracteres, 1 maiúscula, 1 número.
# NUNCA use "pwd" (valor de exemplo) fora da sua máquina local.
ORACLE_PWD=changeMe123

# Senha do usuário ADMIN do Oracle APEX (workspace INTERNAL), usada pelo
# container "ords" para configurar o APEX na primeira inicialização.
# Regras: mínimo 8 caracteres, 1 maiúscula, 1 minúscula, 1 número.
APEX_PWD=changeMe123

# Portas expostas no HOST (fora do container). Altere se já estiverem em uso
# na sua máquina (ex.: se você já tem um Oracle DB local na 1521).
DB_HOST_PORT=1522
ORDS_HOST_PORT=8081
